import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { ButtonGroup } from "@axonyx/ui/foundry/ButtonGroup.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { HeroCard } from "@axonyx/ui/foundry/HeroCard.ax"
import { Marketing01 } from "@axonyx/ui/blocks/marketing-01"
import { SectionCard } from "@axonyx/ui/foundry/SectionCard.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page MarketingBlock() {
  return ASX {
    <Container max="xl">
      <Stack gap="xl">
        <HeroCard title="marketing-01">
          <Copy slot="eyebrow">Blocks V0</Copy>
          <Copy tone="lead">A responsive product landing page section set imported from `@axonyx/ui/blocks/marketing-01`.</Copy>
          <ButtonGroup>
            <Button href="/blocks/docs-01" variant="primary">Next: docs-01</Button>
            <Button href="/blocks" variant="ghost">All blocks</Button>
          </ButtonGroup>
        </HeroCard>

        <Card title="Preview from axonyx-ui" border="forged">
          <Marketing01 />
        </Card>

        <ContentGrid cols={2} gap="lg">
          <Card title="Install">
            <DocsCodeBlock>{"cargo ax add block marketing-01"}</DocsCodeBlock>
          </Card>
          <Card title="Import">
            <DocsCodeBlock>{"import { Marketing01 } from \"@axonyx/ui/blocks/marketing-01\"\n\n<Marketing01 />"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
      </Stack>
    </Container>
  }
}
