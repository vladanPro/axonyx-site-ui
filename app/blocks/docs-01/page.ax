import { Badge } from "@axonyx/ui/foundry/Badge.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { HeroCard } from "@axonyx/ui/foundry/HeroCard.ax"
import { Sidebar } from "@axonyx/ui/foundry/Sidebar.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page DocsBlock() {
  return ASX {
    <Container max="xl">
      <Stack gap="xl">
        <HeroCard title="docs-01">
          <Copy slot="eyebrow">Blocks V0</Copy>
          <Copy tone="lead">A documentation shell with sidebar navigation, content rail, status callouts, and next/previous page flow.</Copy>
          <Button href="/blocks/dashboard-01" variant="primary">Next: dashboard-01</Button>
        </HeroCard>

        <Card title="Preview" border="forged">
          <div class="ax-app-shell">
            <Sidebar>
              <strong>Docs</strong>
              <a href="/components/button">Button</a>
              <a href="/components/card">Card</a>
              <a href="/components/field">Field</a>
            </Sidebar>
            <section class="ax-card">
              <span class="site-badge">Guide</span>
              <h3 class="ax-card__title">Getting started</h3>
              <p>Install the CLI, choose a starter, run dev, then build static output.</p>
              <pre class="docs-code">{"create-axonyx my-docs --yes --template docs\ncargo ax run dev"}</pre>
            </section>
          </div>
        </Card>

        <ContentGrid cols={2} gap="lg">
          <Card title="Install">
            <pre class="docs-code">{"cargo ax add block docs-01"}</pre>
          </Card>
          <Card title="Block contract">
            <Copy>Expected files: `app/docs/page.ax`, shared docs sidebar, page pager, and `use "@axonyx/ui"` layout wiring.</Copy>
          </Card>
        </ContentGrid>
      </Stack>
    </Container>
  }
}
