import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Badge } from "@axonyx/ui/foundry/Badge.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { PageHeader } from "@axonyx/ui/foundry/PageHeader.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page PageHeaderPage() {
  return ASX {
    <ComponentPage
      title="PageHeader"
      category="Page composition"
      description="Header surface for docs pages, component pages, dashboards, and section intros."
      nextHref="/components/popover"
      nextLabel="Next: Popover"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <PageHeader title="Build with Foundry">
              <Badge slot="eyebrow" tone="success">Guide</Badge>
              <Copy>Use a PageHeader when the page needs a strong title, short explanation, and actions.</Copy>
              <Button slot="actions" href="/components" variant="primary">All components</Button>
            </PageHeader>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<PageHeader title=\"Build with Foundry\">\n  <Badge slot=\"eyebrow\">Guide</Badge>\n  <Copy>Use a PageHeader for page intros.</Copy>\n  <Button slot=\"actions\">All components</Button>\n</PageHeader>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
    </ComponentPage>
  }
}
