import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Badge } from "@axonyx/ui/foundry/Badge.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page AppShellPage() {
  return ASX {
    <ComponentPage
      title="AppShell"
      category="Layout V0"
      description="Application frame for docs, dashboards, CMS tools, and any screen that needs a rail plus a main content plane."
      nextHref="/components/sidebar"
      nextLabel="Next: Sidebar"
    >

        <Card title="Preview" border="forged">
          <div class="ax-app-shell">
            <aside class="ax-sidebar">
              <strong>Foundry</strong>
              <a href="/components/button">Button</a>
              <a href="/components/card">Card</a>
              <a href="/blocks/dashboard-01">Dashboard</a>
            </aside>
            <section class="ax-card">
              <h3 class="ax-card__title">Main plane</h3>
              <p>Use this shell for documentation, admin screens, and CMS interfaces.</p>
            </section>
          </div>
        </Card>

        <ContentGrid cols={2} gap="lg">
          <Card title="Axonyx">
            <DocsCodeBlock>{"import { AppShell } from \"@axonyx/ui/foundry/AppShell.ax\"\nimport { Sidebar } from \"@axonyx/ui/foundry/Sidebar.ax\"\n\n<AppShell rail=\"left\" railWidth=\"md\">\n  <Sidebar slot=\"rail\">...</Sidebar>\n  <Card title=\"Main\">...</Card>\n</AppShell>"}</DocsCodeBlock>
          </Card>
          <Card title="Generated HTML shape">
            <DocsCodeBlock>{"<div class=\"ax-app-shell\" data-rail=\"left\" data-rail-width=\"md\">\n  <aside class=\"ax-sidebar\">...</aside>\n  <main>...</main>\n</div>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>

        <Card title="API contract" surface="inset">
          <Badge tone="success">V0</Badge>
          <Copy>`rail`, `railWidth`, and `gap` define the first AppShell layout contract.</Copy>
        </Card>
    </ComponentPage>
  }
}
