import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Badge } from "@axonyx/ui/foundry/Badge.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"
import { Surface } from "@axonyx/ui/foundry/Surface.asx"

page SurfacePage() {
  return ASX {
    <ComponentPage
      title="Surface"
      category="Layout"
      description="General section shell for themed panels, docs islands, and feature blocks."
      nextHref="/components/status-lamp"
      nextLabel="Next: StatusLamp"
    >

        <ContentGrid cols={2} gap="lg">
          <Surface eyebrow="Runtime" title="Forged panel" variant="forged" padding="lg"><Copy>Use Surface when the layout needs a clear material boundary.</Copy><Badge tone="success">stable</Badge></Surface>
          <Surface eyebrow="Docs" title="Inset panel" variant="inset" padding="lg"><Copy>Use inset surfaces for reference notes and dense examples.</Copy></Surface>
        </ContentGrid>

        <Surface title="Axonyx" padding="lg">
          <DocsCodeBlock>{"<Surface eyebrow=\"Runtime\" title=\"Forged panel\" variant=\"forged\">\n  <Copy>Use Surface for material boundaries.</Copy>\n</Surface>"}</DocsCodeBlock>
        </Surface>
    </ComponentPage>
  }
}
