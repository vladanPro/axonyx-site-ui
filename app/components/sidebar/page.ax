import { Sidebar } from "@axonyx/ui/foundry/Sidebar.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page SidebarPage() {
  return ASX {
    <Container max="xl">
      <Stack gap="xl">
        <HeroCard title="Sidebar">
          <Copy slot="eyebrow">Layout V0</Copy>
          <Copy tone="lead">Navigation rail for docs, dashboards, settings, and future Blockbit admin surfaces.</Copy>
          <Button href="/blocks/dashboard-01" variant="primary">Try dashboard block</Button>
        </HeroCard>

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <Sidebar>
              <strong>Registry</strong>
              <a href="/components">Components</a>
              <a href="/blocks">Blocks</a>
              <a href="/themes">Themes</a>
              <a href="/registry">Install model</a>
            </Sidebar>
          </Card>
          <Card title="Usage">
            <Badge tone="success">V0</Badge>
            <Copy>Sidebar stays simple: clear links, strong grouping, and CSS-owned responsive behavior.</Copy>
          </Card>
        </ContentGrid>

        <ContentGrid cols={2} gap="lg">
          <Card title="Axonyx">
            <DocsCodeBlock>{"<Sidebar>\n  <strong>Docs</strong>\n  <a href=\"/docs\">Overview</a>\n  <a href=\"/docs/getting-started\">Getting started</a>\n</Sidebar>"}</DocsCodeBlock>
          </Card>
          <Card title="Generated HTML shape">
            <DocsCodeBlock>{"<aside class=\"ax-sidebar\">\n  <strong>Docs</strong>\n  <a href=\"/docs\">Overview</a>\n  <a href=\"/docs/getting-started\">Getting started</a>\n</aside>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
      </Stack>
    </Container>
  }
}
