import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Badge } from "@axonyx/ui/foundry/Badge.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { DropdownItem } from "@axonyx/ui/foundry/DropdownItem.ax"
import { DropdownMenu } from "@axonyx/ui/foundry/DropdownMenu.ax"
import { HeroCard } from "@axonyx/ui/foundry/HeroCard.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page DropdownMenuPage() {
  return ASX {
    <Container max="xl">
      <Stack gap="xl">
        <HeroCard title="DropdownMenu">
          <Copy slot="eyebrow">Navigation</Copy>
          <Copy tone="lead">Compact command and navigation menu for headers, dashboards, and CMS toolbars.</Copy>
          <Button href="/components/status-lamp" variant="primary">Next: StatusLamp</Button>
        </HeroCard>

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <DropdownMenu align="end" variant="secondary">
              <span slot="trigger">Component actions</span>
              <DropdownItem href="/components">All components</DropdownItem>
              <DropdownItem href="/blocks">Preview blocks</DropdownItem>
              <DropdownItem href="/create">Get code</DropdownItem>
            </DropdownMenu>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<DropdownMenu align=\"end\">\n  <span slot=\"trigger\">Component actions</span>\n  <DropdownItem href=\"/components\">All components</DropdownItem>\n</DropdownMenu>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>

        <Card title="API contract" surface="inset">
          <Badge tone="success">V0</Badge>
          <Copy>`align`, trigger slot, and item links define the first menu contract.</Copy>
        </Card>
      </Stack>
    </Container>
  }
}
