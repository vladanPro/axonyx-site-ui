import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Badge } from "@axonyx/ui/foundry/Badge.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { DropdownItem } from "@axonyx/ui/foundry/DropdownItem.asx"
import { DropdownMenu } from "@axonyx/ui/foundry/DropdownMenu.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page DropdownMenuPage() {
  return ASX {
    <ComponentPage
      title="DropdownMenu"
      category="Navigation"
      description="Compact navigation menu for headers, dashboards, and CMS toolbars. Arrow keys move through links; Escape closes and returns focus to the trigger."
      nextHref="/components/status-lamp"
      nextLabel="Next: StatusLamp"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <DropdownMenu align="end" variant="secondary">
              <span slot="trigger">Component actions</span>
              <DropdownItem href="/components">All components</DropdownItem>
              <DropdownItem href="/blocks">Preview blocks</DropdownItem>
              <DropdownItem href="/create">Get code</DropdownItem>
            </DropdownMenu>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<DropdownMenu align=\"end\">\n  <span slot=\"trigger\">Component actions</span>\n  <DropdownItem href=\"/components\">All components</DropdownItem>\n</DropdownMenu>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>

        <Card title="API contract" surface="inset">
          <Badge tone="success">V0</Badge>
          <Copy>Use ArrowDown or ArrowUp on the trigger to open and focus a link. Inside the menu, Arrow keys and Home/End move focus; Tab leaves the menu and Escape restores focus to the trigger.</Copy>
        </Card>
    </ComponentPage>
  }
}
