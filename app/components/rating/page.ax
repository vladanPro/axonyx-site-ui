import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Rating } from "@axonyx/ui/foundry/Rating.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page RatingPage() {
  return ASX {
    <ComponentPage
      title="Rating"
      category="Signal"
      description="Compact rating display for reviews, quality signals, and ranking panels."
      nextHref="/components/select"
      nextLabel="Next: Select"
    >

        <ContentGrid cols={3} gap="lg">
          <Card title="Docs quality"><Rating value="5" label="Excellent" /></Card>
          <Card title="Component maturity"><Rating value="4" label="Ready" /></Card>
          <Card title="Preview status"><Rating value="3" label="Beta" /></Card>
        </ContentGrid>

        <Card title="Axonyx">
          <DocsCodeBlock>{"<Rating value=\"5\" label=\"Excellent\" />"}</DocsCodeBlock>
        </Card>
    </ComponentPage>
  }
}
