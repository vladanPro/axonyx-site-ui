import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { HeroCard } from "@axonyx/ui/foundry/HeroCard.ax"
import { Rating } from "@axonyx/ui/foundry/Rating.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page RatingPage() {
  return ASX {
    <Container max="xl">
      <Stack gap="xl">
        <HeroCard title="Rating">
          <Copy tone="eyebrow">Signal</Copy>
          <Copy tone="lead">Compact rating display for reviews, quality signals, and ranking panels.</Copy>
          <Button href="/components/select" variant="primary">Next: Select</Button>
        </HeroCard>

        <ContentGrid cols={3} gap="lg">
          <Card title="Docs quality"><Rating value="5" label="Excellent" /></Card>
          <Card title="Component maturity"><Rating value="4" label="Ready" /></Card>
          <Card title="Preview status"><Rating value="3" label="Beta" /></Card>
        </ContentGrid>

        <Card title="Axonyx">
          <DocsCodeBlock>{"<Rating value=\"5\" label=\"Excellent\" />"}</DocsCodeBlock>
        </Card>
      </Stack>
    </Container>
  }
}
