import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { HeroCard } from "@axonyx/ui/foundry/HeroCard.ax"
import { Menu } from "@axonyx/ui/foundry/Menu.ax"
import { MenuItem } from "@axonyx/ui/foundry/MenuItem.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page MenuPage() {
  return ASX {
    <Container max="xl">
      <Stack gap="xl">
        <HeroCard title="Menu">
          <Copy tone="eyebrow">Navigation</Copy>
          <Copy tone="lead">Vertical navigation list for sidebars, settings sections, and dashboard panels.</Copy>
          <Button href="/components/machine-switch" variant="primary">Next: MachineSwitch</Button>
        </HeroCard>

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <Menu ariaLabel="Settings menu">
              <MenuItem href="/components/menu" active="true">General</MenuItem>
              <MenuItem href="/components/forms">Forms</MenuItem>
              <MenuItem href="/components/table">Data</MenuItem>
              <MenuItem href="/components/tooltip" disabled="true">Advanced</MenuItem>
            </Menu>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<Menu ariaLabel=\"Settings menu\">\n  <MenuItem active=\"true\">General</MenuItem>\n  <MenuItem>Forms</MenuItem>\n</Menu>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
      </Stack>
    </Container>
  }
}
