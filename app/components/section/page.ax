import { Badge } from "@axonyx/ui/foundry/Badge.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Section } from "@axonyx/ui/foundry/Section.asx"

page SectionPage() {
  return ASX {
    <ComponentPage title="Section" category="Layout primitive" description="Section owns page-level rhythm, content width, alignment, and optional heading content." nextHref="/components/inset" nextLabel="Next: Inset">
      <Card border="forged">
        <Section width="lg" spacing="sm" align="center" eyebrow="Foundry" title="One section contract" description="Compose a page without rebuilding heading and spacing rules for every route.">
          <Badge tone="success">responsive</Badge>
        </Section>
      </Card>
      <DocsCodeBlock>{"<Section width=\"lg\" spacing=\"sm\" align=\"center\"\n  eyebrow=\"Foundry\" title=\"One section contract\"\n  description=\"Reusable page rhythm.\"\n>\n  <Content />\n</Section>"}</DocsCodeBlock>
    </ComponentPage>
  }
}
