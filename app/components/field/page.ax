import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Badge } from "@axonyx/ui/foundry/Badge.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Field } from "@axonyx/ui/foundry/Field.asx"
import { FieldError } from "@axonyx/ui/foundry/FieldError.asx"
import { FieldHint } from "@axonyx/ui/foundry/FieldHint.asx"
import { FieldLabel } from "@axonyx/ui/foundry/FieldLabel.asx"
import { Input } from "@axonyx/ui/foundry/Input.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page FieldPage() {
  return ASX {
    <ComponentPage
      title="Field"
      category="Components V0"
      description="A form shell for labels, inputs, hints, and validation states across static forms and future Axonyx actions."
      nextHref="/components/app-shell"
      nextLabel="Next: AppShell"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <Field htmlFor="project-name">
              <FieldLabel htmlFor="project-name">Project name</FieldLabel>
              <Input id="project-name" name="project" placeholder="Blockbit CMS" />
              <FieldHint>Use a short public name.</FieldHint>
            </Field>
          </Card>
          <Card title="Validation state">
            <Field state="error" htmlFor="email">
              <FieldLabel htmlFor="email">Email</FieldLabel>
              <Input id="email" name="email" placeholder="you@company.dev" />
              <FieldError>Email is required before submitting.</FieldError>
            </Field>
          </Card>
        </ContentGrid>

        <ContentGrid cols={2} gap="lg">
          <Card title="Axonyx">
            <DocsCodeBlock>{"<Field htmlFor=\"email\">\n  <FieldLabel htmlFor=\"email\">Email</FieldLabel>\n  <Input id=\"email\" name=\"email\" />\n  <FieldHint>We only use this for deploy updates.</FieldHint>\n</Field>"}</DocsCodeBlock>
          </Card>
          <Card title="Generated HTML shape">
            <DocsCodeBlock>{"<label class=\"ax-field\" for=\"email\">\n  <span class=\"ax-field__label\">Email</span>\n  <input class=\"ax-input\" id=\"email\" name=\"email\" />\n</label>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>

        <Card title="API contract" surface="inset">
          <Badge tone="success">V0</Badge>
          <Copy>`state` and `htmlFor` define the first Field shell. Label, Hint, Error, and Input compose inside it.</Copy>
        </Card>
    </ComponentPage>
  }
}
