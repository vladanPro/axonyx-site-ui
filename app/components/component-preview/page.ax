import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.ax"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Badge } from "@axonyx/ui/foundry/Badge.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { ButtonGroup } from "@axonyx/ui/foundry/ButtonGroup.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { ComponentPreview } from "@axonyx/ui/foundry/ComponentPreview.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page ComponentPreviewPage() {
  return ASX {
    <ComponentPage
      title="ComponentPreview"
      category="Documentation"
      description="Preview stage primitive for component documentation and visual examples."
      nextHref="/components/copy"
      nextLabel="Next: Copy"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <ComponentPreview title="Action group" surface="forged">
              <ButtonGroup>
                <Button variant="primary">Publish</Button>
                <Button variant="ghost">Cancel</Button>
              </ButtonGroup>
            </ComponentPreview>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<ComponentPreview title=\"Action group\" surface=\"forged\">\n  <ButtonGroup>\n    <Button variant=\"primary\">Publish</Button>\n  </ButtonGroup>\n</ComponentPreview>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
    </ComponentPage>
  }
}
