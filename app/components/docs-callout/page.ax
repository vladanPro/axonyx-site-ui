import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Badge } from "@axonyx/ui/foundry/Badge.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { DocsCallout } from "@axonyx/ui/foundry/DocsCallout.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page DocsCalloutPage() {
  return ASX {
    <ComponentPage
      title="DocsCallout"
      category="Documentation"
      description="Documentation callout for notes, warnings, migration hints, and framework guidance."
      nextHref="/components/forms"
      nextLabel="Next: Forms"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <DocsCallout title="Use package behavior">
              <Badge slot="eyebrow" tone="warning">Important</Badge>
              <Copy>Interactive Foundry components should ship behavior from `@axonyx/ui`, not one-off site scripts.</Copy>
            </DocsCallout>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<DocsCallout title=\"Use package behavior\">\n  <Badge slot=\"eyebrow\" tone=\"warning\">Important</Badge>\n  <Copy>Interactive behavior belongs in @axonyx/ui.</Copy>\n</DocsCallout>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
    </ComponentPage>
  }
}
