import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.ax"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page CopyPage() {
  return ASX {
    <ComponentPage
      title="Copy"
      category="Typography"
      description="Readable paragraph primitive for docs, cards, callouts, and product copy."
      nextHref="/components/docs-callout"
      nextLabel="Next: DocsCallout"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <Copy>Axonyx pages should read clearly without forcing authors into raw paragraph classes.</Copy>
            <Copy>Use Copy inside cards, callouts, docs sections, and layout primitives.</Copy>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<Copy>\n  Axonyx pages should read clearly without raw paragraph classes.\n</Copy>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
    </ComponentPage>
  }
}
