import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"
import { Step } from "@axonyx/ui/foundry/Step.asx"
import { Stepper } from "@axonyx/ui/foundry/Stepper.asx"

page StepperPage() {
  return ASX {
    <ComponentPage
      title="Stepper"
      category="Data display"
      description="Ordered progress for setup flows, deploy pipelines, onboarding, and CMS publishing."
      nextHref="/components/timeline"
      nextLabel="Next: Timeline"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Vertical" border="forged">
            <Stepper>
              <Step index="1" title="Configure" description="Choose the project and theme." state="complete" />
              <Step index="2" title="Build" description="Compile ASX and Foundry assets." state="active" />
              <Step index="3" title="Deploy" description="Ship the production binary." />
            </Stepper>
          </Card>
          <Card title="Horizontal">
            <Stepper orientation="horizontal">
              <Step index="1" title="Source" state="complete" />
              <Step index="2" title="Melt" state="active" />
              <Step index="3" title="Runtime" />
            </Stepper>
          </Card>
        </ContentGrid>

        <Card title="Axonyx">
          <DocsCodeBlock>{"<Stepper>\n  <Step index=\"1\" title=\"Configure\" state=\"complete\" />\n  <Step index=\"2\" title=\"Build\" state=\"active\" />\n  <Step index=\"3\" title=\"Deploy\" />\n</Stepper>"}</DocsCodeBlock>
        </Card>
    </ComponentPage>
  }
}
