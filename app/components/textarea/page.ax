import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Field } from "@axonyx/ui/foundry/Field.asx"
import { FieldHint } from "@axonyx/ui/foundry/FieldHint.asx"
import { FieldLabel } from "@axonyx/ui/foundry/FieldLabel.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"
import { Textarea } from "@axonyx/ui/foundry/Textarea.asx"

page TextareaPage() {
  return ASX {
    <ComponentPage
      title="Textarea"
      category="Forms"
      description="Native multi-line input for content, comments, notes, and CMS fields."
      nextHref="/components/slider"
      nextLabel="Next: Slider"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <Field htmlFor="notes">
              <FieldLabel htmlFor="notes">Release notes</FieldLabel>
              <Textarea id="notes" name="notes" placeholder="Describe what changed..." />
              <FieldHint>Used for docs, CMS content, and deploy comments.</FieldHint>
            </Field>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<Textarea id=\"notes\" name=\"notes\" placeholder=\"Describe what changed...\" />"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
    </ComponentPage>
  }
}
