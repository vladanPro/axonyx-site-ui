import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.ax"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Badge } from "@axonyx/ui/foundry/Badge.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { Popover } from "@axonyx/ui/foundry/Popover.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page PopoverPage() {
  return ASX {
    <ComponentPage
      title="Popover"
      category="Overlay"
      description="Small anchored panel for compact help, quick controls, and contextual metadata."
      nextHref="/components/props-table"
      nextLabel="Next: PropsTable"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <Popover side="bottom" variant="secondary">
              <span slot="trigger">Runtime info</span>
              <Badge tone="success">healthy</Badge>
              <Copy>Tokio transport, compression, and security headers are active.</Copy>
            </Popover>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<Popover side=\"bottom\">\n  <span slot=\"trigger\">Runtime info</span>\n  <Copy>Tokio transport is active.</Copy>\n</Popover>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
    </ComponentPage>
  }
}
