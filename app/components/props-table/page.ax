import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.ax"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { PropRow } from "@axonyx/ui/foundry/PropRow.ax"
import { PropsTable } from "@axonyx/ui/foundry/PropsTable.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page PropsTablePage() {
  return ASX {
    <ComponentPage
      title="PropsTable"
      category="Reference"
      description="Reference table primitive for component props, slots, and API contracts."
      nextHref="/components/rating"
      nextLabel="Next: Rating"
    >

        <Card title="Preview" border="forged">
          <PropsTable>
            <PropRow name="variant" type="String" default="primary" description="Visual intent for the component." />
            <PropRow name="surface" type="String" default="" description="Optional Foundry material treatment." />
            <PropRow name="Slot" type="ASX" default="" description="Default child content." />
          </PropsTable>
        </Card>

        <Card title="Axonyx">
          <DocsCodeBlock>{"<PropsTable>\n  <PropRow name=\"variant\" type=\"String\" default=\"primary\" description=\"Visual intent.\" />\n</PropsTable>"}</DocsCodeBlock>
        </Card>
    </ComponentPage>
  }
}
