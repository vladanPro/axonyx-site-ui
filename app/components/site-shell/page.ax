import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Footer } from "@axonyx/ui/foundry/Footer.asx"
import { Header } from "@axonyx/ui/foundry/Header.asx"
import { Main } from "@axonyx/ui/foundry/Main.asx"
import { SiteShell } from "@axonyx/ui/foundry/SiteShell.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page SiteShellPage() {
  return ASX {
    <ComponentPage
      title="SiteShell"
      category="Application frame"
      description="Outer page shell for site-level width, header/footer rhythm, and app content."
      nextHref="/components/stat"
      nextLabel="Next: Stat"
    >

        <Card title="Preview" border="forged">
          <SiteShell max="lg">
            <Header sticky="true"><strong>Axonyx docs</strong></Header>
            <Main><Copy>Use SiteShell with Header, Main, and Footer for simple site frames.</Copy></Main>
            <Footer><Copy>Foundry footer content.</Copy></Footer>
          </SiteShell>
        </Card>

        <Card title="Axonyx">
          <DocsCodeBlock>{"<SiteShell max=\"lg\">\n  <Header sticky=\"true\">Axonyx docs</Header>\n  <Main><Copy>Page content</Copy></Main>\n  <Footer><Copy>Footer content</Copy></Footer>\n</SiteShell>"}</DocsCodeBlock>
        </Card>
    </ComponentPage>
  }
}
