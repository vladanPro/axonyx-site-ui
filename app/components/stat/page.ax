import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"
import { Stat } from "@axonyx/ui/foundry/Stat.asx"

page StatPage() {
  return ASX {
    <ComponentPage
      title="Stat"
      category="Metrics"
      description="Metric panel for dashboard KPIs, runtime health, build performance, and CMS analytics."
      nextHref="/components/slider"
      nextLabel="Next: Slider"
    >

        <ContentGrid cols={3} gap="lg">
          <Stat tone="success"><span slot="label">Response</span><span slot="value">413ms</span><span slot="delta">-38%</span>Render response after rebuild.</Stat>
          <Stat tone="info"><span slot="label">Routes</span><span slot="value">42</span><span slot="delta">+1</span>Static routes generated by Melt.</Stat>
          <Stat tone="warning"><span slot="label">Coverage</span><span slot="value">28</span><span slot="delta">Aegis</span>Fast checks in the UI showcase.</Stat>
        </ContentGrid>

        <Card title="Axonyx">
          <DocsCodeBlock>{"<Stat tone=\"success\">\n  <span slot=\"label\">Response</span>\n  <span slot=\"value\">413ms</span>\n  <span slot=\"delta\">-38%</span>\n  Render response after rebuild.\n</Stat>"}</DocsCodeBlock>
        </Card>
    </ComponentPage>
  }
}
