import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Badge } from "@axonyx/ui/foundry/Badge.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"
import { Table } from "@axonyx/ui/foundry/Table.asx"
import { TableBody } from "@axonyx/ui/foundry/TableBody.asx"
import { TableCell } from "@axonyx/ui/foundry/TableCell.asx"
import { TableHead } from "@axonyx/ui/foundry/TableHead.asx"
import { TableHeaderCell } from "@axonyx/ui/foundry/TableHeaderCell.asx"
import { TableRow } from "@axonyx/ui/foundry/TableRow.asx"

page TablePage() {
  return ASX {
    <ComponentPage
      title="Table"
      category="Data display"
      description="Structured rows for CMS content lists, package metadata, dashboards, and API previews."
      nextHref="/components/dialog"
      nextLabel="Next: Dialog"
    >

        <Card title="Preview" border="forged">
          <Table density="compact" zebra="true">
            <TableHead>
              <TableRow><TableHeaderCell>Package</TableHeaderCell><TableHeaderCell>Status</TableHeaderCell><TableHeaderCell align="right">Version</TableHeaderCell></TableRow>
            </TableHead>
            <TableBody>
              <TableRow><TableCell>axonyx-ui</TableCell><TableCell>published</TableCell><TableCell align="right">0.0.x</TableCell></TableRow>
              <TableRow><TableCell>cargo-axonyx</TableCell><TableCell>published</TableCell><TableCell align="right">0.1.x</TableCell></TableRow>
            </TableBody>
          </Table>
        </Card>

        <ContentGrid cols={2} gap="lg">
          <Card title="Axonyx">
            <DocsCodeBlock>{"<Table density=\"compact\" zebra=\"true\">\n  <TableHead>\n    <TableRow><TableHeaderCell>Package</TableHeaderCell></TableRow>\n  </TableHead>\n  <TableBody>\n    <TableRow><TableCell>axonyx-ui</TableCell></TableRow>\n  </TableBody>\n</Table>"}</DocsCodeBlock>
          </Card>
          <Card title="API contract">
            <Badge tone="success">V0</Badge>
            <Copy>`Table` owns density/zebra. Row and cell primitives keep HTML semantic.</Copy>
          </Card>
        </ContentGrid>
    </ComponentPage>
  }
}
