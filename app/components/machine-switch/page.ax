import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.ax"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Badge } from "@axonyx/ui/foundry/Badge.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { MachineSwitch } from "@axonyx/ui/foundry/MachineSwitch.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page MachineSwitchPage() {
  return ASX {
    <ComponentPage
      title="MachineSwitch"
      category="Industrial control"
      description="Two-pad forged switch for runtime features, workers, deploy gates, and CMS automation controls."
      nextHref="/components/pagination"
      nextLabel="Next: Pagination"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Offline"><MachineSwitch label="Media worker" state="off" stateLabel="Offline" offActive="true" /></Card>
          <Card title="Online"><MachineSwitch label="Stream runtime" state="on" stateLabel="Online" onActive="true" pressed="true" /></Card>
        </ContentGrid>

        <Card title="Axonyx">
          <DocsCodeBlock>{"<MachineSwitch label=\"Stream runtime\" state=\"on\" stateLabel=\"Online\" onActive=\"true\" />"}</DocsCodeBlock>
        </Card>
    </ComponentPage>
  }
}
