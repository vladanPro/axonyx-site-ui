import { Badge } from "@axonyx/ui/foundry/Badge.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { HeroCard } from "@axonyx/ui/foundry/HeroCard.ax"
import { SectionCard } from "@axonyx/ui/foundry/SectionCard.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page Components() {
  return ASX {
    <Container max="xl">
      <Stack gap="xl">
        <HeroCard title="Components">
          <Copy slot="eyebrow">Foundry primitives</Copy>
          <Copy tone="lead">
            The component catalog starts with the pieces needed to build real
            sites and dashboards: actions, surfaces, inputs, overlays, layout,
            navigation, feedback, and data display.
          </Copy>
          <Button href="/blocks" variant="primary">See blocks</Button>
        </HeroCard>

        <ContentGrid cols={3} gap="lg">
          <SectionCard title="Button">
            <Badge tone="success">V0</Badge>
            <Copy>Primary actions, ghost actions, forged surfaces, and link-like calls to action.</Copy>
            <Button href="/components/button" variant="ghost">Open Button</Button>
          </SectionCard>
          <SectionCard title="Card">
            <Badge tone="success">V0</Badge>
            <Copy>Foundry surface primitive for content panels, dashboard widgets, and docs blocks.</Copy>
            <Button href="/components/card" variant="ghost">Open Card</Button>
          </SectionCard>
          <SectionCard title="Field">
            <Badge tone="success">V0</Badge>
            <Copy>Label, input, hint, and error shell for native forms and action inputs.</Copy>
            <Button href="/components/field" variant="ghost">Open Field</Button>
          </SectionCard>
          <SectionCard title="AppShell">
            <Badge tone="success">V0</Badge>
            <Copy>Application frame for docs, dashboards, admin tools, and CMS layouts.</Copy>
            <Button href="/components/app-shell" variant="ghost">Open AppShell</Button>
          </SectionCard>
          <SectionCard title="Sidebar">
            <Badge tone="success">V0</Badge>
            <Copy>Navigation rail used by AppShell, docs pages, dashboards, and admin blocks.</Copy>
            <Button href="/components/sidebar" variant="ghost">Open Sidebar</Button>
          </SectionCard>
          <SectionCard title="Next wave">
            <Badge tone="info">After V0</Badge>
            <Copy>Tabs, Dialog, Drawer, Table, Select, Toast, Tooltip, and StatusLamp come after the proof loop.</Copy>
          </SectionCard>
        </ContentGrid>
      </Stack>
    </Container>
  }
}
