import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Fieldset } from "@axonyx/ui/foundry/Fieldset.asx"
import { Legend } from "@axonyx/ui/foundry/Legend.asx"
import { Radio } from "@axonyx/ui/foundry/Radio.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page RadioPage() {
  return ASX {
    <ComponentPage
      title="Radio"
      category="Forms"
      description="Native radio option for plans, settings, templates, and mutually exclusive choices."
      nextHref="/components/rating"
      nextLabel="Next: Rating"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <Fieldset surface="forged">
              <Legend>Template</Legend>
              <Radio name="template" value="site" checked="true">Site</Radio>
              <Radio name="template" value="docs">Docs</Radio>
              <Radio name="template" value="blog">Blog</Radio>
            </Fieldset>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<Radio name=\"template\" value=\"site\" checked=\"true\">Site</Radio>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
    </ComponentPage>
  }
}
