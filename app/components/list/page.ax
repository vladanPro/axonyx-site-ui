import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Badge } from "@axonyx/ui/foundry/Badge.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { HeroCard } from "@axonyx/ui/foundry/HeroCard.ax"
import { List } from "@axonyx/ui/foundry/List.ax"
import { ListItem } from "@axonyx/ui/foundry/ListItem.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page ListPage() {
  return ASX {
    <Container max="xl">
      <Stack gap="xl">
        <HeroCard title="List">
          <Copy slot="eyebrow">Data display</Copy>
          <Copy tone="lead">Stacked rows for navigation, API results, CMS records, notifications, and compact dashboards.</Copy>
          <Button href="/components/machine-switch" variant="primary">Next: MachineSwitch</Button>
        </HeroCard>

        <ContentGrid cols={2} gap="lg">
          <Card title="Build jobs">
            <List divided="true">
              <ListItem tone="success"><span slot="leading">01</span>Static build complete<span slot="trailing">413ms</span></ListItem>
              <ListItem><span slot="leading">02</span>Registry synced<span slot="trailing">ready</span></ListItem>
              <ListItem tone="warning"><span slot="leading">03</span>Theme review pending<span slot="trailing">manual</span></ListItem>
            </List>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<List divided=\"true\">\n  <ListItem tone=\"success\">\n    Static build complete\n  </ListItem>\n</List>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
      </Stack>
    </Container>
  }
}
