import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Badge } from "@axonyx/ui/foundry/Badge.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"
import { Tab } from "@axonyx/ui/foundry/Tab.asx"
import { Tabs } from "@axonyx/ui/foundry/Tabs.asx"

page TabsPage() {
  return ASX {
    <ComponentPage
      title="Tabs"
      category="Navigation"
      description="Segment related content without changing route: docs examples, API sections, and dashboard panels."
      nextHref="/components/table"
      nextLabel="Next: Table"
    >

        <Card title="Preview" border="forged">
          <Tabs defaultValue="preview">
            <Tab title="Preview" value="preview"><Copy>Rendered component output.</Copy></Tab>
            <Tab title="Code" value="code"><Copy>Install and import example.</Copy></Tab>
            <Tab title="API" value="api"><Copy>Stable props for the primitive.</Copy></Tab>
          </Tabs>
        </Card>

        <ContentGrid cols={2} gap="lg">
          <Card title="Axonyx">
            <DocsCodeBlock>{"import { Tabs } from \"@axonyx/ui/foundry/Tabs\"\nimport { Tab } from \"@axonyx/ui/foundry/Tab\"\n\n<Tabs defaultValue=\"preview\">\n  <Tab title=\"Preview\" value=\"preview\">...</Tab>\n  <Tab title=\"Code\" value=\"code\">...</Tab>\n</Tabs>"}</DocsCodeBlock>
          </Card>
          <Card title="API contract">
            <Badge tone="success">V0</Badge>
            <Copy>`defaultValue` selects the first tab. `Tab` owns `title`, `value`, and panel children.</Copy>
          </Card>
        </ContentGrid>
    </ComponentPage>
  }
}
