import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.ax"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { ButtonGroup } from "@axonyx/ui/foundry/ButtonGroup.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"
import { Toolbar } from "@axonyx/ui/foundry/Toolbar.ax"

page ToolbarPage() {
  return ASX {
    <ComponentPage
      title="Toolbar"
      category="Actions"
      description="Horizontal action strip for editors, table tools, dashboard filters, and CMS controls."
      nextHref="/components/progress"
      nextLabel="Next: Progress"
    >

        <Card title="Preview" border="forged">
          <Toolbar variant="forged">
            <ButtonGroup>
              <Button variant="primary">Publish</Button>
              <Button variant="secondary">Preview</Button>
              <Button variant="ghost">Archive</Button>
            </ButtonGroup>
          </Toolbar>
        </Card>

        <Card title="Axonyx">
          <DocsCodeBlock>{"<Toolbar variant=\"forged\">\n  <ButtonGroup>\n    <Button variant=\"primary\">Publish</Button>\n    <Button variant=\"ghost\">Archive</Button>\n  </ButtonGroup>\n</Toolbar>"}</DocsCodeBlock>
        </Card>
    </ComponentPage>
  }
}
