import { Box } from "@axonyx/ui/foundry/Box.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { ComponentExample } from "@axonyx/ui/foundry/ComponentExample.asx"
import { ComponentInstall } from "@axonyx/ui/foundry/ComponentInstall.asx"
import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Field } from "@axonyx/ui/foundry/Field.asx"
import { FieldError } from "@axonyx/ui/foundry/FieldError.asx"
import { FieldHint } from "@axonyx/ui/foundry/FieldHint.asx"
import { FieldLabel } from "@axonyx/ui/foundry/FieldLabel.asx"
import { Flex } from "@axonyx/ui/foundry/Flex.asx"
import { Form } from "@axonyx/ui/foundry/Form.asx"
import { Option } from "@axonyx/ui/foundry/Option.asx"
import { Select } from "@axonyx/ui/foundry/Select.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page SelectPage() {
  return ASX {
    <ComponentPage title="Select" category="Forms" description="Native select control with Foundry sizing, accessible field labels, required validation, and real selected and disabled option flags." nextHref="/components/slider" nextLabel="Next: Slider">
      <Stack gap="xl">
        <ComponentExample title="Theme choice" description="Use the forged surface for a focused selector. Choosing a value here demonstrates the control; it does not change the site palette.">
          <Field slot="preview" htmlFor="theme">
            <FieldLabel htmlFor="theme">Theme</FieldLabel>
            <Select id="theme" name="theme" surface="forged" describedBy="theme-choice-hint">
              <Option value="silver">Silver</Option>
              <Option value="bronze">Bronze</Option>
              <Option value="gold">Gold</Option>
            </Select>
            <FieldHint id="theme-choice-hint">Native select, Foundry styled.</FieldHint>
          </Field>
          <DocsCodeBlock slot="code" language="asx">{"<Select name=\"theme\" surface=\"forged\">\n  <Option value=\"silver\">Silver</Option>\n  <Option value=\"bronze\">Bronze</Option>\n  <Option value=\"gold\">Gold</Option>\n</Select>"}</DocsCodeBlock>
        </ComponentExample>

        <ComponentExample title="Selection and reset" description="Start from a non-first option, try the arrow keys, and reset after changing the value. Disabled options remain unavailable with JavaScript switched off.">
          <div slot="preview" id="option-form">
            <Form method="get" action="/components/select#option-form">
              <Field htmlFor="publication-status">
                <FieldLabel htmlFor="publication-status">Publication status</FieldLabel>
                <Select id="publication-status" name="status" describedBy="publication-status-hint">
                  <Option value="draft" selected="false" disabled="false">Draft</Option>
                  <Option value="published" selected="true">Published</Option>
                  <Option value="archived" disabled="true">Archived (unavailable)</Option>
                  <Option value="scheduled">Scheduled</Option>
                </Select>
                <FieldHint id="publication-status-hint">Published is selected initially. Arrow keys skip Archived; reset restores Published.</FieldHint>
              </Field>
              <Flex gap="sm" wrap="true">
                <Button type="submit" variant="primary">Preview selection</Button>
                <Button type="reset" variant="ghost">Reset selection</Button>
              </Flex>
              <Copy>This GET preview returns to the same page with the selected status in the URL. Nothing is saved.</Copy>
            </Form>
          </div>
          <DocsCodeBlock slot="code" language="asx">{"<Form method=\"get\" action=\"/components/select#option-form\">\n  <Field htmlFor=\"publication-status\">\n    <FieldLabel htmlFor=\"publication-status\">Publication status</FieldLabel>\n    <Select id=\"publication-status\" name=\"status\" describedBy=\"publication-status-hint\">\n      <Option value=\"draft\" selected=\"false\" disabled=\"false\">Draft</Option>\n      <Option value=\"published\" selected=\"true\">Published</Option>\n      <Option value=\"archived\" disabled=\"true\">Archived (unavailable)</Option>\n      <Option value=\"scheduled\">Scheduled</Option>\n    </Select>\n    <FieldHint id=\"publication-status-hint\">Published is selected initially. Arrow keys skip Archived; reset restores Published.</FieldHint>\n  </Field>\n  <Flex gap=\"sm\" wrap=\"true\">\n    <Button type=\"submit\" variant=\"primary\">Preview selection</Button>\n    <Button type=\"reset\" variant=\"ghost\">Reset selection</Button>\n  </Flex>\n  <Copy>This GET preview returns to the same page with the selected status in the URL. Nothing is saved.</Copy>\n</Form>"}</DocsCodeBlock>
        </ComponentExample>

        <ComponentExample title="Required and disabled controls" description="Use a selected, disabled placeholder for a required choice. A disabled select can show a server-assigned value without submitting it.">
          <div slot="preview" id="required-select-preview">
            <Form method="get" action="/components/select#required-select-preview">
              <Field htmlFor="select-category">
                <FieldLabel htmlFor="select-category">Category</FieldLabel>
                <Select id="select-category" name="category" required="true" describedBy="select-category-hint">
                  <Option value="" selected="true" disabled="true">Choose a category</Option>
                  <Option value="news">News</Option>
                  <Option value="guides">Guides</Option>
                </Select>
                <FieldHint id="select-category-hint">Choose a category before submitting. The empty placeholder does not satisfy required validation.</FieldHint>
              </Field>
              <Field htmlFor="select-locale">
                <FieldLabel htmlFor="select-locale">Locale</FieldLabel>
                <Select id="select-locale" name="locale" disabled="true">
                  <Option value="en">English (assigned by the server)</Option>
                </Select>
                <FieldHint>A disabled select is excluded from form submission.</FieldHint>
              </Field>
              <Button type="submit" variant="primary">Preview category</Button>
            </Form>
          </div>
          <DocsCodeBlock slot="code" language="asx">{"<Form method=\"get\" action=\"/components/select#required-select-preview\">\n  <Field htmlFor=\"select-category\">\n    <FieldLabel htmlFor=\"select-category\">Category</FieldLabel>\n    <Select id=\"select-category\" name=\"category\" required=\"true\" describedBy=\"select-category-hint\">\n      <Option value=\"\" selected=\"true\" disabled=\"true\">Choose a category</Option>\n      <Option value=\"news\">News</Option>\n      <Option value=\"guides\">Guides</Option>\n    </Select>\n    <FieldHint id=\"select-category-hint\">Choose a category before submitting. The empty placeholder does not satisfy required validation.</FieldHint>\n  </Field>\n  <Field htmlFor=\"select-locale\">\n    <FieldLabel htmlFor=\"select-locale\">Locale</FieldLabel>\n    <Select id=\"select-locale\" name=\"locale\" disabled=\"true\">\n      <Option value=\"en\">English (assigned by the server)</Option>\n    </Select>\n    <FieldHint>A disabled select is excluded from form submission.</FieldHint>\n  </Field>\n  <Button type=\"submit\" variant=\"primary\">Preview category</Button>\n</Form>"}</DocsCodeBlock>
        </ComponentExample>

        <ComponentExample title="Error presentation" description="An example of a server-rejected value. aria-invalid and the linked message describe the error; validation belongs in the server action.">
          <Field slot="preview" state="error" htmlFor="select-error-status">
            <FieldLabel htmlFor="select-error-status">Status</FieldLabel>
            <Select id="select-error-status" name="status_example" invalid="true" describedBy="select-error-message">
              <Option value="published">Published</Option>
            </Select>
            <FieldError id="select-error-message">Publishing is unavailable for this record.</FieldError>
          </Field>
          <DocsCodeBlock slot="code" language="asx">{"<Field state=\"error\" htmlFor=\"status\">\n  <FieldLabel htmlFor=\"status\">Status</FieldLabel>\n  <Select id=\"status\" name=\"status\" invalid=\"true\" describedBy=\"status-error\">\n    <Option value=\"published\">Published</Option>\n  </Select>\n  <FieldError id=\"status-error\">Publishing is unavailable for this record.</FieldError>\n</Field>"}</DocsCodeBlock>
        </ComponentExample>

        <ComponentInstall>
          <DocsCodeBlock title="Cargo.toml" language="toml">{"[dependencies]\naxonyx-ui = \"0.0.80\""}</DocsCodeBlock>
          <DocsCodeBlock title="app/layout.asx" language="asx">{"use \"@axonyx/ui\""}</DocsCodeBlock>
        </ComponentInstall>
        <Box padding="lg" surface="inset">
          <Stack gap="md">
            <h2>Select and Option contract</h2>
            <DocsCodeBlock title="Imports" language="asx">{"import { Select } from \"@axonyx/ui/foundry/Select.asx\"\nimport { Option } from \"@axonyx/ui/foundry/Option.asx\""}</DocsCodeBlock>
            <Copy>Select id/name: identify and submit the control. Match id to FieldLabel htmlFor and describedBy to a hint or error message ID.</Copy>
            <Copy>Select size: optional String, sm or lg. surface: optional String, forged. disabled, required, and invalid use the String flag "true".</Copy>
            <Copy>Option value: String, default empty. The value sent by the form. Its content slot supplies the visible label.</Copy>
            <Copy>Option selected and disabled: String flags, default empty. Set "true" to emit the native boolean attribute. Empty or "false" leaves that attribute absent.</Copy>
            <Copy>Use selected on one option to set the initial selection and reset target. The browser owns subsequent selection changes. Use a disabled empty option as a placeholder for a required select.</Copy>
            <Copy>Native selection, keyboard navigation, reset, and submission work without package JavaScript. Server actions must still validate submitted values against their allowed list.</Copy>
            <a href="/components/form">Use Select in the CMS article editor</a>
          </Stack>
        </Box>
      </Stack>
    </ComponentPage>
  }
}
