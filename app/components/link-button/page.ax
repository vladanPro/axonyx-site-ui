import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { LinkButton } from "@axonyx/ui/foundry/LinkButton.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page LinkButtonPage() {
  return ASX {
    <ComponentPage
      title="LinkButton"
      category="Actions"
      description="Anchor navigation with the visual weight of a Foundry button."
      nextHref="/components/text-link"
      nextLabel="Next: TextLink"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <Stack gap="md">
              <LinkButton href="/create" variant="primary" surface="forged">Get code</LinkButton>
              <LinkButton href="/themes" variant="secondary">Explore themes</LinkButton>
              <LinkButton href="/components" variant="ghost">All components</LinkButton>
            </Stack>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<LinkButton href=\"/create\" variant=\"primary\" surface=\"forged\">\n  Get code\n</LinkButton>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
    </ComponentPage>
  }
}
