import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.ax"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Badge } from "@axonyx/ui/foundry/Badge.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"
import { Tooltip } from "@axonyx/ui/foundry/Tooltip.ax"

page TooltipPage() {
  return ASX {
    <ComponentPage
      title="Tooltip"
      category="Overlay"
      description="Small explanatory layer for dense controls, status lamps, and dashboard actions."
      nextHref="/components"
      nextLabel="Back to components"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <Tooltip label="Runs cargo ax check before deploy">
              <Button variant="secondary">Production check</Button>
            </Tooltip>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<Tooltip label=\"Runs cargo ax check before deploy\">\n  <Button variant=\"secondary\">Production check</Button>\n</Tooltip>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>

        <Card title="API contract" surface="inset">
          <Badge tone="success">V0</Badge>
          <Copy>`label` is the default content. A named `content` slot is available for richer tooltip copy.</Copy>
        </Card>
    </ComponentPage>
  }
}
