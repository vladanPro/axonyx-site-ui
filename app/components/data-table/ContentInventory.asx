import { DataTable } from "@axonyx/ui/foundry/DataTable"
import { Table } from "@axonyx/ui/foundry/Table"
import { TableHead } from "@axonyx/ui/foundry/TableHead"
import { TableBody } from "@axonyx/ui/foundry/TableBody"
import { TableRow } from "@axonyx/ui/foundry/TableRow"
import { TableHeaderCell } from "@axonyx/ui/foundry/TableHeaderCell"
import { TableCell } from "@axonyx/ui/foundry/TableCell"

component ContentInventory() {
  return ASX {
    <DataTable label="Content inventory" pageSize="2" searchLabel="Search posts">
      <Table>
        <caption class="ax-table__caption">Five sample posts. Search covers these loaded records only.</caption>
        <TableHead>
          <TableRow>
            <TableHeaderCell sort="text">Title</TableHeaderCell>
            <TableHeaderCell sort="text">Status</TableHeaderCell>
          </TableRow>
        </TableHead>
        <TableBody>
          <TableRow><TableCell><a href="#alpha">Alpha</a></TableCell><TableCell>Published</TableCell></TableRow>
          <TableRow><TableCell>Echo</TableCell><TableCell>Draft</TableCell></TableRow>
          <TableRow><TableCell>Bravo</TableCell><TableCell>Published</TableCell></TableRow>
          <TableRow><TableCell>Delta</TableCell><TableCell>Draft</TableCell></TableRow>
          <TableRow><TableCell>Charlie</TableCell><TableCell>Published</TableCell></TableRow>
        </TableBody>
      </Table>
    </DataTable>
  }
}
