import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"
import { Step } from "@axonyx/ui/foundry/Step.asx"
import { Stepper } from "@axonyx/ui/foundry/Stepper.asx"
import { Timeline } from "@axonyx/ui/foundry/Timeline.asx"
import { TimelineItem } from "@axonyx/ui/foundry/TimelineItem.asx"

page TimelinePage() {
  return ASX {
    <ComponentPage
      title="Timeline"
      category="Progression"
      description="Timeline and stepper primitives for releases, worker events, onboarding, and guides."
      nextHref="/components/toolbar"
      nextLabel="Next: Toolbar"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Timeline">
            <Timeline>
              <TimelineItem time="09:10" title="Build started"><Copy>Axonyx Melt started compiling ASX pages.</Copy></TimelineItem>
              <TimelineItem time="09:11" title="Routes emitted" tone="success"><Copy>Static output and route graph completed.</Copy></TimelineItem>
            </Timeline>
          </Card>
          <Card title="Stepper">
            <Stepper>
              <Step index="1" title="Install" description="Add the component from registry." state="complete" />
              <Step index="2" title="Compose" description="Use it in ASX." state="active" />
              <Step index="3" title="Deploy" description="Ship static or server output." />
            </Stepper>
          </Card>
        </ContentGrid>

        <Card title="Axonyx">
          <DocsCodeBlock>{"<Timeline>\n  <TimelineItem time=\"09:10\" title=\"Build started\">\n    <Copy>Axonyx Melt started compiling ASX pages.</Copy>\n  </TimelineItem>\n</Timeline>"}</DocsCodeBlock>
        </Card>
    </ComponentPage>
  }
}
