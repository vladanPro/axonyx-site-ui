import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.ax"
import { Badge } from "@axonyx/ui/foundry/Badge.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { Card } from "@axonyx/ui/foundry/Card.ax"
import { Command } from "@axonyx/ui/foundry/Command.ax"
import { CommandList } from "@axonyx/ui/foundry/CommandList.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { HeroCard } from "@axonyx/ui/foundry/HeroCard.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page CommandPage() {
  return ASX {
    <Container max="xl">
      <Stack gap="xl">
        <HeroCard title="Command">
          <Copy tone="eyebrow">Command surfaces</Copy>
          <Copy tone="lead">Command surfaces for quick actions, admin tools, and keyboard-driven workflows.</Copy>
          <Button href="/components/empty-state" variant="primary">Next: EmptyState</Button>
        </HeroCard>

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <Command>
              <CommandList title="Project commands">
                <Badge slot="eyebrow" tone="success">Axonyx</Badge>
                <Copy>Run build</Copy>
                <Copy>Open component catalog</Copy>
                <Copy>Check deployment health</Copy>
                <Button slot="actions" variant="primary">Run command</Button>
              </CommandList>
            </Command>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<Command>\n  <CommandList title=\"Project commands\">\n    <Copy>Run build</Copy>\n    <Button slot=\"actions\">Run command</Button>\n  </CommandList>\n</Command>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
      </Stack>
    </Container>
  }
}
