import { ComponentPage } from "@axonyx/ui/foundry/ComponentPage.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { Badge } from "@axonyx/ui/foundry/Badge.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { Command } from "@axonyx/ui/foundry/Command.asx"
import { CommandList } from "@axonyx/ui/foundry/CommandList.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page CommandPage() {
  return ASX {
    <ComponentPage
      title="Command"
      category="Command surfaces"
      description="Command surfaces for quick actions, admin tools, and keyboard-driven workflows."
      nextHref="/components/empty-state"
      nextLabel="Next: EmptyState"
    >

        <ContentGrid cols={2} gap="lg">
          <Card title="Preview" border="forged">
            <Command>
              <CommandList title="Project commands">
                <Badge slot="eyebrow" tone="success">Axonyx</Badge>
                <Copy>Run build</Copy>
                <Copy>Open component catalog</Copy>
                <Copy>Check deployment health</Copy>
                <Button slot="actions" variant="primary">Run command</Button>
              </CommandList>
            </Command>
          </Card>
          <Card title="Axonyx">
            <DocsCodeBlock>{"<Command>\n  <CommandList title=\"Project commands\">\n    <Copy>Run build</Copy>\n    <Button slot=\"actions\">Run command</Button>\n  </CommandList>\n</Command>"}</DocsCodeBlock>
          </Card>
        </ContentGrid>
    </ComponentPage>
  }
}
