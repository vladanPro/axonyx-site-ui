import { Stack } from "@axonyx/ui/foundry/Stack.asx"
import { TextLink } from "@axonyx/ui/foundry/TextLink.asx"

page NavbarPage() {
  return ASX {
    <ComponentPage
      title="Navbar"
      category="Navigation"
      description="Top-level navigation shell for product pages, docs, dashboards, and app headers."
      nextHref="/components/pagination"
      nextLabel="Next: Pagination"
    >

        <Card title="Preview" border="forged">
          <Navbar brandHref="/">
            <strong slot="brand">Axonyx UI</strong>
            <TextLink href="/components">Components</TextLink>
            <TextLink href="/blocks">Blocks</TextLink>
            <TextLink href="/themes">Themes</TextLink>
          </Navbar>
        </Card>

        <Card title="Axonyx">
          <DocsCodeBlock>{"<Navbar brandHref=\"/\">\n  <strong slot=\"brand\">Axonyx UI</strong>\n  <TextLink href=\"/components\">Components</TextLink>\n</Navbar>"}</DocsCodeBlock>
        </Card>
    </ComponentPage>
  }
}
