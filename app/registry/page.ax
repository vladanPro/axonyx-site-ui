import { SectionCard } from "@axonyx/ui/foundry/SectionCard.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page Registry() {
  return ASX {
    <Container max="xl">
      <Stack gap="xl">
        <HeroCard title="Registry V1">
          <Copy slot="eyebrow">Import-first, copy-customize when needed</Copy>
          <Copy tone="lead">
            Axonyx UI now has a package registry contract: every component and
            block declares its import path, preview URL, category, status, and
            future copy command from the same `Axonyx.registry.toml` manifest.
          </Copy>
          <Button href="/blocks/marketing-01" variant="primary">Preview first block</Button>
        </HeroCard>

        <ContentGrid cols={2} gap="lg">
          <SectionCard title="Use from package" border="forged">
            <Badge tone="success">Recommended</Badge>
            <DocsCodeBlock>{"cargo ax add ui\n\nuse \"@axonyx/ui\"\nimport { Button } from \"@axonyx/ui/foundry/Button\"\nimport { Marketing01 } from \"@axonyx/ui/blocks/marketing-01\""}</DocsCodeBlock>
            <Copy>
              This works like the MUI-style package model: install the UI
              package once, then import primitives and blocks directly.
            </Copy>
          </SectionCard>

          <SectionCard title="Copy when you want ownership" border="forged">
            <Badge tone="warning">Later V1 CLI</Badge>
            <DocsCodeBlock>{"cargo ax add block marketing-01\ncargo ax add button"}</DocsCodeBlock>
            <Copy>
              Copy mode is the shadcn-style escape hatch. It will place source
              files in your app so you can reshape the component without waiting
              for package changes.
            </Copy>
          </SectionCard>
        </ContentGrid>

        <section class="ui-section-head">
          <Badge tone="success">Components</Badge>
          <h2>Foundry primitives</h2>
          <Copy tone="lead">
            These entries are the first stable native `.ax` primitives for
            application layouts, docs, dashboards, and CMS screens.
          </Copy>
        </section>

        <div class="ui-registry-grid">
          <a class="ui-registry-card" href="/components/button">
            <Badge tone="success">actions</Badge>
            <strong>Button</strong>
            <span>@axonyx/ui/foundry/Button</span>
          </a>
          <a class="ui-registry-card" href="/components/card">
            <Badge tone="success">surfaces</Badge>
