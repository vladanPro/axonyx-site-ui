        </div>

        <section class="ui-section-head">
          <Badge tone="warning">Blocks</Badge>
          <h2>Installable page sections</h2>
          <Copy tone="lead">
            Blocks prove the larger idea: a programmer can start from complete
            page sections, then gradually compose or replace parts.
          </Copy>
        </section>

        <ContentGrid cols={3} gap="lg">
          <Card title="Marketing 01" border="forged">
            <Badge tone="success">marketing</Badge>
            <Copy>Hero, proof cards, feature grid, and call to action.</Copy>
            <DocsCodeBlock>{"import { Marketing01 } from \"@axonyx/ui/blocks/marketing-01\""}</DocsCodeBlock>
            <Button href="/blocks/marketing-01" variant="ghost">Open preview</Button>
          </Card>
          <Card title="Docs 01" border="forged">
            <Badge tone="success">docs</Badge>
            <Copy>Documentation shell with sidebar, content rail, and install command space.</Copy>
            <DocsCodeBlock>{"import { Docs01 } from \"@axonyx/ui/blocks/docs-01\""}</DocsCodeBlock>
            <Button href="/blocks/docs-01" variant="ghost">Open preview</Button>
          </Card>
          <Card title="Dashboard 01" border="forged">
            <Badge tone="warning">dashboard</Badge>
            <Copy>Industrial admin shell for CMS, deploy, QA, and registry screens.</Copy>
            <DocsCodeBlock>{"import { Dashboard01 } from \"@axonyx/ui/blocks/dashboard-01\""}</DocsCodeBlock>
            <Button href="/blocks/dashboard-01" variant="ghost">Open preview</Button>
