import { Badge } from "@axonyx/ui/foundry/Badge.asx"
import { Button } from "@axonyx/ui/foundry/Button.asx"
import { ButtonGroup } from "@axonyx/ui/foundry/ButtonGroup.asx"
import { Card } from "@axonyx/ui/foundry/Card.asx"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.asx"
import { Copy } from "@axonyx/ui/foundry/Copy.asx"
import { DocsCodeBlock } from "@axonyx/ui/foundry/DocsCodeBlock.asx"
import { SectionCard } from "@axonyx/ui/foundry/SectionCard.asx"
import { Stack } from "@axonyx/ui/foundry/Stack.asx"

page Home() {
  return ASX {
    <Head>
      <Title>Axonyx UI | Foundry component registry</Title>
    </Head>

    <Container max="xl">
      <Stack gap="xl">
        <section class="ui-hero">
          <div>
            <span class="ui-kicker">Foundry registry V0</span>
            <h1>Build interfaces from forged parts.</h1>
            <p class="ui-hero__lead">
              Axonyx UI is the component and block registry for Axonyx-native
              Rust apps. Think shadcn-style open code, but Cargo-first,
              dark-first, and shaped for the Rust web stack.
            </p>
            <div class="ui-hero__actions">
              <Button href="/components/button" variant="primary" surface="forged">Start with Button</Button>
              <Button href="/create" variant="secondary">Get code</Button>
              <Button href="/blocks/marketing-01" variant="ghost">Preview blocks</Button>
            </div>
          </div>

          <div class="ui-preview-panel">
            <div class="ui-preview-toolbar">
              <span>ui.axonyx.dev</span>
              <span>Axonyx native</span>
            </div>
            <div class="ui-code-window">
              <div class="ui-code-window__bar">
                <span class="ui-code-window__dot"></span>
                <span class="ui-code-window__dot"></span>
                <span class="ui-code-window__dot"></span>
              </div>
              <pre>{"use \"@axonyx/ui\"\nimport { Button } from \"@axonyx/ui/foundry/Button\"\nimport { Card } from \"@axonyx/ui/foundry/Card\"\n\npage Dashboard() {\n  return ASX {\n    <Card title=\"Deploy health\" border=\"forged\">\n      <Button variant=\"primary\" surface=\"forged\">\n        Run production check\n      </Button>\n    </Card>\n  }\n}"}</pre>
            </div>
            <div class="ui-command-row">
              <div class="ui-command">
                <span>component</span>
                <code>cargo ax add button</code>
              </div>
              <div class="ui-command">
                <span>block</span>
                <code>cargo ax add block dashboard-01</code>
              </div>
            </div>
          </div>
        </section>

        <div class="ui-status-rail">
          <div>
            <span>Component catalog</span>
            <strong>58+</strong>
            <small>layout, actions, forms, navigation, overlays, and data</small>
          </div>
          <div>
            <span>Blocks V0</span>
            <strong>5</strong>
            <small>marketing, docs, dashboard, login, and settings</small>
          </div>
          <div>
            <span>Install path</span>
            <strong>Cargo</strong>
            <small>import first, copy/customize later</small>
          </div>
          <div>
            <span>Theme layer</span>
            <strong>Foundry</strong>
            <small>silver, bronze, gold</small>
          </div>
        </div>

        <section class="ui-section-head">
          <Badge tone="success">Source of truth</Badge>
          <h2>One registry for native Axonyx apps.</h2>
          <Copy tone="lead">
            Native `.ax` components are the canonical Foundry contract. React,
            Vite, TanStack, and React Router examples live on the sibling React
            adapter site.
          </Copy>
        </section>

        <div class="ui-registry-grid">
          <a class="ui-registry-card" href="/components/button">
            <Badge tone="success">V0</Badge>
            <strong>Button</strong>
            <span>Primary actions, ghost links, forged surfaces, and call-to-action composition.</span>
          </a>
          <a class="ui-registry-card" href="/components/card">
            <Badge tone="success">V0</Badge>
            <strong>Card</strong>
            <span>Foundry surfaces for docs, dashboards, and CMS panels.</span>
          </a>
          <a class="ui-registry-card" href="/components/field">
            <Badge tone="success">V0</Badge>
            <strong>Field</strong>
            <span>Form layout with labels, hints, input controls, and validation states.</span>
          </a>
          <a class="ui-registry-card" href="/components/app-shell">
            <Badge tone="info">Layout</Badge>
            <strong>AppShell</strong>
            <span>Application frame for docs, admin, dashboard, and Blockbit flows.</span>
          </a>
        </div>

        <ContentGrid cols={3} gap="lg">
          <SectionCard title="marketing-01" border="forged">
            <Badge tone="success">Block</Badge>
            <Copy>Hero, proof cards, feature grid, and final call to action.</Copy>
            <Button href="/blocks/marketing-01" variant="ghost">Open preview</Button>
          </SectionCard>
          <SectionCard title="docs-01" border="forged">
            <Badge tone="success">Block</Badge>
            <Copy>Sidebar, content rail, install commands, and pager navigation.</Copy>
            <Button href="/blocks/docs-01" variant="ghost">Open preview</Button>
          </SectionCard>
          <SectionCard title="dashboard-01" border="forged">
            <Badge tone="warning">Block</Badge>
            <Copy>Metrics, console sidebar, status cards, and future data panels.</Copy>
            <Button href="/blocks/dashboard-01" variant="ghost">Open preview</Button>
          </SectionCard>
          <SectionCard title="login-01" border="forged">
            <Badge tone="success">Block</Badge>
            <Copy>Native sign-in form, system status panel, and secure session boundary.</Copy>
            <Button href="/blocks/login-01" variant="ghost">Open preview</Button>
          </SectionCard>
          <SectionCard title="settings-01" border="forged">
            <Badge tone="success">Block</Badge>
            <Copy>Responsive app shell, workspace preferences, and explicit destructive actions.</Copy>
            <Button href="/blocks/settings-01" variant="ghost">Open preview</Button>
          </SectionCard>
        </ContentGrid>

        <ContentGrid cols={2} gap="lg">
          <Card title="Install once, compose everywhere" border="forged">
            <Copy tone="lead">
              Axonyx UI should feel familiar to people coming from shadcn or MUI,
              but the source contract is native `.ax` and Cargo-first.
            </Copy>
            <DocsCodeBlock title="Install">
              {"cargo ax add ui\n\nuse \"@axonyx/ui\"\nimport { Button } from \"@axonyx/ui/foundry/Button\"\nimport { Dashboard01 } from \"@axonyx/ui/blocks/dashboard-01\""}
            </DocsCodeBlock>
          </Card>
          <Card title="Two tracks, one visual contract" border="forged">
            <Copy>
              This site is for Rust/Axonyx-native usage. The React adapter site
              will mirror the same Foundry primitives for Next, Vite, TanStack,
              and React Router users.
            </Copy>
            <ButtonGroup>
              <Button href="https://react.axonyx.dev" variant="ghost">React adapter</Button>
              <Button href="https://axonyx.dev" variant="ghost">Axonyx framework</Button>
            </ButtonGroup>
          </Card>
        </ContentGrid>

        <Card title="Registry V0 contract" border="forged" surface="inset">
          <Copy tone="lead">
            The first milestone is not "all components." It is one complete,
            believable loop: install a component, install a block, switch between
            native Axonyx examples, and keep the same Foundry theme contract.
          </Copy>
          <ButtonGroup>
            <Button href="/create" variant="primary">Get code</Button>
            <Button href="/components" variant="primary">Browse components</Button>
            <Button href="/themes" variant="ghost">Theme system</Button>
          </ButtonGroup>
        </Card>
      </Stack>
    </Container>
  }
}
