import { Badge } from "@axonyx/ui/foundry/Badge.ax"
import { Button } from "@axonyx/ui/foundry/Button.ax"
import { ButtonGroup } from "@axonyx/ui/foundry/ButtonGroup.ax"
import { ContentGrid } from "@axonyx/ui/foundry/ContentGrid.ax"
import { Copy } from "@axonyx/ui/foundry/Copy.ax"
import { FeatureSection } from "@axonyx/ui/foundry/FeatureSection.ax"
import { HeroCard } from "@axonyx/ui/foundry/HeroCard.ax"
import { SectionCard } from "@axonyx/ui/foundry/SectionCard.ax"
import { Stack } from "@axonyx/ui/foundry/Stack.ax"

page Home() {
  return ASX {
    <Head>
      <Title>Axonyx UI | Foundry component registry</Title>
    </Head>

    <Container max="xl">
      <Stack gap="xl">
        <HeroCard title="Foundry components for Axonyx and React.">
          <Copy slot="eyebrow">Axonyx UI registry</Copy>
          <Copy tone="lead">
            A dark-first industrial design system shaped like shadcn, but built
            for the Axonyx stack: native `.ax` components first, React adapter
            second, blocks and themes as installable product pieces.
          </Copy>
          <ButtonGroup>
            <Button href="/components" variant="primary">Browse components</Button>
            <Button href="/blocks" variant="ghost">View blocks</Button>
          </ButtonGroup>
        </HeroCard>

        <ContentGrid cols={3} gap="lg">
          <SectionCard title="Native source">
            <Badge tone="success">Cargo-first</Badge>
            <Copy>
              Foundry components ship from `axonyx-ui` as Cargo assets and `.ax`
              primitives that Axonyx apps can import directly.
            </Copy>
          </SectionCard>
          <SectionCard title="React adapter">
            <Badge tone="info">Next/Vite ready</Badge>
            <Copy>
              `@axonyx/react` maps the same visual contract into React components
              without making React the source of truth.
            </Copy>
          </SectionCard>
          <SectionCard title="Blocks">
            <Badge tone="warning">App sections</Badge>
            <Copy>
              Dashboards, docs shells, marketing pages, login screens, and CMS
              panels should install as complete responsive building blocks.
            </Copy>
          </SectionCard>
        </ContentGrid>

        <ContentGrid cols={2} gap="lg">
          <FeatureSection title="The shadcn idea, but forged for Axonyx">
            <Copy slot="eyebrow">Open code, stable contract</Copy>
            <Copy>
              The target is not a closed widget box. Axonyx UI should be readable,
              copyable, themeable, and easy to override while the framework keeps
              the Rust runtime, static output, and state bridge underneath.
            </Copy>
          </FeatureSection>
          <FeatureSection title="One design language across Rust and React">
            <Copy slot="eyebrow">Axonyx | React switch</Copy>
            <Copy>
              Every component page should show the native Axonyx version and the
              React adapter version side by side, so teams can migrate gradually.
            </Copy>
          </FeatureSection>
        </ContentGrid>

        <SectionCard title="Registry V0 plan" border="forged" surface="inset">
          <Copy tone="lead">
            Start small and prove the loop: `Button`, `Card`, `Field`,
            `AppShell`, `Sidebar`, then blocks for marketing, docs, dashboard,
            login, and CMS admin.
          </Copy>
          <pre class="docs-code">{"cargo ax add button\ncargo ax add block dashboard-01\ncargo ax add theme bronze"}</pre>
        </SectionCard>
      </Stack>
    </Container>
  }
}
