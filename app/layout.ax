use "@axonyx/ui"
import { Sidebar } from "@axonyx/ui/foundry/Sidebar.ax"
import { SiteShell } from "@axonyx/ui/foundry/SiteShell.ax"
import { TextLink } from "@axonyx/ui/foundry/TextLink.ax"
import { ThemeSwitcher } from "@axonyx/ui/foundry/ThemeSwitcher.ax"

page RootLayout() {
  return ASX {
    <Head>
      <Title>Axonyx UI</Title>
      <Theme storageKey="axonyx-site-ui-theme" default="silver" preflight="true" />
      <Meta name="description" content="Axonyx UI is the Foundry component registry for Axonyx-native Rust apps." />
      <Link rel="icon" href="https://axonyx.dev/brand-mark.svg" type="image/svg+xml" />
      <Link rel="stylesheet" href="/ui-site.css" />
      <Script src="/js/ui-site.js?v=0.0.1" defer="true" />
    </Head>

    <header class="site-nav">
      <div class="site-header__inner">
        <a class="site-brand" href="/">
          <img src="https://axonyx.dev/brand-mark.svg" alt="Axonyx UI" class="site-logo" width={80} height={80} />
          <span>Axonyx UI</span>
        </a>
        <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="site-nav-links">
          <span></span>
          <span></span>
          <span></span>
          Menu
        </button>
        <nav class="site-nav__links" id="site-nav-links">
          <TextLink href="/">Home</TextLink>
          <TextLink href="/components">Components</TextLink>
          <TextLink href="/blocks">Blocks</TextLink>
          <TextLink href="/create">Get Code</TextLink>
          <TextLink href="/themes">Themes</TextLink>
          <TextLink href="https://axonyx.dev">Axonyx</TextLink>
          <TextLink href="https://react.axonyx.dev">React</TextLink>
        </nav>
        <ThemeSwitcher label="Theme" size="sm" surface="forged" storageKey="axonyx-site-ui-theme" ariaLabel="Choose theme" />
      </div>
    </header>

    <SiteShell max="xl">

      <div class="ui-docs-shell">
        <Sidebar>
          <nav class="ui-sidebar-nav" aria-label="Axonyx UI navigation">
            <div class="ui-sidebar-group">
              <strong>Start</strong>
              <a href="/">Overview</a>
              <a href="/create">Get Code</a>
              <a href="/components">All components</a>
              <a href="/themes">Themes</a>
            </div>

            <div class="ui-sidebar-group">
              <strong>Components</strong>
              <a href="/components/button">Button</a>
              <a href="/components/button-group">ButtonGroup</a>
              <a href="/components/card">Card</a>
              <a href="/components/field">Field</a>
              <a href="/components/layout">Layout</a>
              <a href="/components/avatar">Avatar</a>
              <a href="/components/chip">Chip</a>
              <a href="/components/code-block">CodeBlock</a>
              <a href="/components/component-preview">ComponentPreview</a>
              <a href="/components/copy">Copy</a>
              <a href="/components/docs-callout">DocsCallout</a>
              <a href="/components/forms">Forms</a>
              <a href="/components/icon-button">IconButton</a>
              <a href="/components/accordion">Accordion</a>
              <a href="/components/alert">Alert</a>
              <a href="/components/badge">Badge</a>
              <a href="/components/breadcrumbs">Breadcrumbs</a>
              <a href="/components/command">Command</a>
              <a href="/components/empty-state">EmptyState</a>
              <a href="/components/list">List</a>
              <a href="/components/menu">Menu</a>
              <a href="/components/modal">Modal</a>
              <a href="/components/machine-switch">MachineSwitch</a>
              <a href="/components/navbar">Navbar</a>
              <a href="/components/pagination">Pagination</a>
              <a href="/components/page-header">PageHeader</a>
              <a href="/components/popover">Popover</a>
              <a href="/components/props-table">PropsTable</a>
              <a href="/components/radio">Radio</a>
              <a href="/components/rating">Rating</a>
              <a href="/components/select">Select</a>
              <a href="/components/site-shell">SiteShell</a>
              <a href="/components/stat">Stat</a>
              <a href="/components/theme-switcher">ThemeSwitcher</a>
              <a href="/components/textarea">Textarea</a>
              <a href="/components/slider">Slider</a>
              <a href="/components/switch">Switch</a>
              <a href="/components/tabs">Tabs</a>
              <a href="/components/table">Table</a>
              <a href="/components/dialog">Dialog</a>
              <a href="/components/drawer">Drawer</a>
              <a href="/components/dropdown-menu">DropdownMenu</a>
              <a href="/components/surface">Surface</a>
              <a href="/components/status-lamp">StatusLamp</a>
              <a href="/components/timeline">Timeline</a>
              <a href="/components/toolbar">Toolbar</a>
              <a href="/components/progress">Progress</a>
              <a href="/components/skeleton">Skeleton</a>
              <a href="/components/toast">Toast</a>
              <a href="/components/tooltip">Tooltip</a>
            </div>

            <div class="ui-sidebar-group">
              <strong>Layout</strong>
              <a href="/components/app-shell">AppShell</a>
              <a href="/components/sidebar">Sidebar</a>
            </div>

            <div class="ui-sidebar-group">
              <strong>Blocks</strong>
              <a href="/blocks/marketing-01">marketing-01</a>
              <a href="/blocks/docs-01">docs-01</a>
              <a href="/blocks/dashboard-01">dashboard-01</a>
            </div>
          </nav>
        </Sidebar>

        <main class="ui-docs-main">
          <Slot />
        </main>
      </div>

      <footer class="ax-site-footer">
        <span>Axonyx UI</span>
        <span>Foundry registry and native Axonyx components for Rust-first apps.</span>
      </footer>
    </SiteShell>
  }
}
